{
  "name": "9router-vscode-monitor",
  "displayName": "9Router (VS Code)",
  "description": "Native VS Code Quota Tracker & Usage Monitor for 9Router",
  "version": "1.0.2",
  "publisher": "harpun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/H-pun/9router-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "9router-sidebar",
          "title": "9Router",
          "icon": "media/router-icon.svg"
        }
      ]
    },
    "views": {
      "9router-sidebar": [
        {
          "type": "webview",
          "id": "9router.quotaTrackerView",
          "name": "Quota Tracker"
        },
        {
          "type": "webview",
          "id": "9router.usageView",
          "name": "Usage"
        }
      ]
    },
    "submenus": [
      {
        "id": "9router.filterSubmenu",
        "label": "Filter Accounts",
        "icon": "$(filter)"
      }
    ],
    "commands": [
      {
        "command": "9router.filterActive",
        "title": "Active Accounts"
      },
      {
        "command": "9router.filterAll",
        "title": "All Accounts"
      },
      {
        "command": "9router.filterIdle",
        "title": "Inactive / Turn Off"
      },
      {
        "command": "9router.refreshStats",
        "title": "Refresh Quotas",
        "icon": "$(refresh)"
      },
      {
        "command": "9router.refreshUsage",
        "title": "Refresh Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "9router.configureSettings",
        "title": "Configure 9Router Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "9router.openWebDashboard",
        "title": "Open 9Router Web Dashboard",
        "icon": "$(globe)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "submenu": "9router.filterSubmenu",
          "when": "view == 9router.quotaTrackerView",
          "group": "navigation@1"
        },
        {
          "command": "9router.refreshStats",
          "when": "view == 9router.quotaTrackerView",
          "group": "navigation@2"
        },
        {
          "command": "9router.configureSettings",
          "when": "view == 9router.quotaTrackerView",
          "group": "navigation@3"
        },
        {
          "command": "9router.openWebDashboard",
          "when": "view == 9router.quotaTrackerView",
          "group": "navigation@4"
        },
        {
          "command": "9router.refreshUsage",
          "when": "view == 9router.usageView",
          "group": "navigation@1"
        }
      ],
      "9router.filterSubmenu": [
        {
          "command": "9router.filterActive",
          "group": "1_filter@1"
        },
        {
          "command": "9router.filterAll",
          "group": "1_filter@2"
        },
        {
          "command": "9router.filterIdle",
          "group": "1_filter@3"
        }
      ]
    },
    "configuration": {
      "title": "9Router Monitor",
      "properties": {
        "9router.baseUrl": {
          "type": "string",
          "default": "http://localhost:20128",
          "description": "Base URL of the 9Router server instance"
        },
        "9router.apiKey": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "**Deprecated.** API key sekarang disimpan di Secret Storage VS Code. Jalankan command **Configure 9Router Settings** untuk memindahkannya.",
          "description": "(Deprecated) API Key untuk autentikasi ke 9Router."
        },
        "9router.refreshInterval": {
          "type": "number",
          "default": 900,
          "description": "Auto-refresh interval in seconds for quota tracking (default: 900s / 15 mins)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc --noEmit -p ./",
    "watch": "tsc --noEmit -watch -p ./",
    "build": "node esbuild.js --production",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.40",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  }
}
